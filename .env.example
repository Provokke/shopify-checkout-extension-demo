# Nothing here reads secrets at runtime. The extension runs in Shopify's checkout
# sandbox and gets its config from the merchant settings in shopify.extension.toml.
# Only the Shopify CLI needs these, when you link the app to your own Partner dev store.
#
# Leave them blank in git. `shopify app dev` writes the real values to a
# git-ignored .env after you log in and link an app.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE=your-dev-store.myshopify.com
