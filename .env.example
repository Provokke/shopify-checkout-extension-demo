# Nothing in this repo reads secrets at runtime: the extension runs inside
# Shopify's checkout sandbox and takes its configuration from the merchant
# settings in shopify.extension.toml. These are only needed by the Shopify CLI
# when you link the app to YOUR OWN Partner dev store.
#
# Leave blank in git. `shopify app dev` writes the real values to a local,
# git-ignored file (.env) after you log in and link an app.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE=your-dev-store.myshopify.com
