{
  "name": "shopify-checkout-extension-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free-shipping progress bar as a Shopify Checkout UI extension (Polaris web components + Preact), with a local preview harness.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build:extension && npm run build:harness",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:harness": "vite build",
    "preview:dev": "vite",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.4",
    "@shopify/ui-extensions": "^2026.10.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "preact": "^11.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
